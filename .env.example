# Numenor configuration. Copy to .env and adjust.
# This file must never contain real secrets — it is committed to the repository.

# --- Operator account ---------------------------------------------------
# If NUMENOR_ADMIN_PASSWORD is unset, a random password is generated on first
# start-up and printed to the server console exactly once.
NUMENOR_ADMIN_USER=operator
#NUMENOR_ADMIN_PASSWORD=

# --- Secrets ------------------------------------------------------------
# Where the credential-encryption key and session key are kept. This directory
# must live outside the repository and outside the database. Keys are created
# with 0600 permissions on first start-up if they do not exist.
#NUMENOR_SECRET_DIR=/var/lib/numenor/secrets
# Alternatively supply the keys directly (e.g. from your secret manager):
#NUMENOR_SECRET_KEY=          # Fernet key for camera credentials
#NUMENOR_SESSION_KEY=         # HMAC key for session tokens

# --- Storage ------------------------------------------------------------
#NUMENOR_DATA_DIR=/var/lib/numenor/data
#NUMENOR_DATABASE_URL=sqlite:////var/lib/numenor/data/numenor.db

# --- Camera network policy ----------------------------------------------
# Cameras on RFC1918 / link-local addresses are allowed by default.
# Add extra ranges only if your cameras live outside those.
#NUMENOR_EXTRA_CIDRS=100.64.0.0/10
#NUMENOR_ALLOW_PUBLIC_HOSTS=0
# Development and test rigs only — allows a camera simulator on localhost.
#NUMENOR_ALLOW_LOOPBACK=0

# --- Timeouts and limits ------------------------------------------------
#NUMENOR_CONNECT_TIMEOUT=4
#NUMENOR_ONVIF_TIMEOUT=8
#NUMENOR_SNAPSHOT_TIMEOUT=15
#NUMENOR_MAX_PREVIEW_SESSIONS=4
#NUMENOR_PREVIEW_IDLE_TIMEOUT=30
#NUMENOR_PREVIEW_MAX_LIFETIME=600
#NUMENOR_MAX_UPLOAD_BYTES=26214400

# --- Server -------------------------------------------------------------
#NUMENOR_HOST=127.0.0.1
#NUMENOR_PORT=8000
#NUMENOR_CORS_ORIGINS=http://localhost:5173
#NUMENOR_FFMPEG=ffmpeg
